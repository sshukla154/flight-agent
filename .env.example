# .env.example — template only. Credential VARIABLE NAMES, never values.
#
# Copy to .env (already gitignored — see .gitignore) and fill in real
# secrets there. Never put a real secret in this file or in
# config/config.toml: master plan §7 is explicit that secrets come from
# env or a secret file only, never from the config file, and
# config_digest strips anything that looks like a secret before hashing
# so a committed report can never leak one either.
#
# Per DECISIONS.md D6, both adapters are interface-complete but mock-only
# ships: with these unset, Amadeus/Duffel adapters raise
# ProviderNotConfigured at runtime rather than silently falling back to
# the mock provider.

# --- Amadeus: OAuth2 client_credentials (master plan §5, "Provider abstraction") ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" or "production" — Amadeus uses separate hosts per environment.
AMADEUS_ENV=

# --- Duffel: static bearer + mandatory Duffel-Version header (master plan §5) ---
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_VERSION=
